// vi:ft=text:

#name re;

re: re expr #ast re... expr | expr #ast expr;

expr: match qty #ast match... qty... | match #ast match...;

match: m_any | char;
m_any: '.';

qty_op: "[*+?]";
qty_start #push qty: '{';
qty_cnd #mode qty #pop: ',}';
qty_sep #mode qty #push qtr: ',';
qty_end #mode qty #pop: '}';

q_max #mode qtr #pop: "0|[1-9][0-9]*";
q_min #mode qty: "0|[1-9][0-9]*";

char: "[^.{}*+?[\]]";

qty: qty_op
   | qty_start q_min qty_end #ast q_min
   | qty_start q_min qty_cnd #ast q_min
   | qty_start       qty_sep q_max qty_end #ast q_max
   | qty_start q_min qty_sep q_max qty_end #ast q_min q_max
   ;
